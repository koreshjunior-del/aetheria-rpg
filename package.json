{
  "name": "aetheria-rpg-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create aetheria-rpg-db",
    "db:migrate:local": "wrangler d1 migrations apply aetheria-rpg-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply aetheria-rpg-db --remote"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
